{
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "./dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [ {
      "source": "**",
      "headers": [{
        // Just for fun
        "key": "document-policy",
        "value": "js-profiling"
      }]
    }],
    // https://firebase.google.com/docs/hosting/full-config#rewrites
    "rewrites": [
      {
        "source": "**/app.js.map",
        "destination": "/app.js.map"
      },
      {
        "source": "**/softnav-viewer.html",
        "destination": "/softnav-viewer.html"
      },
      {
        "source": "**/rumtrace-convert.js",
        "destination": "/rumtrace-convert.js"
      },
      {
        "source": "**/rumtrace-convert.js.map",
        "destination": "/rumtrace-convert.js.map"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
